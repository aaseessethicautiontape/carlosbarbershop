# Copy to .env.local and fill in by hand. Never commit .env.local.
# `pnpm db:start` prints the local-only Supabase URL/keys for mock mode.

# --- Mode -------------------------------------------------------------
# mock = local Supabase + outbox log + demo login. live = real services.
NEXT_PUBLIC_APP_MODE=
NEXT_PUBLIC_SITE_URL=

# --- Supabase ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- App secrets ------------------------------------------------------
# 32+ random chars. Signs booking/walk-in links. Generate: openssl rand -base64 48
APP_TOKEN_SECRET=
# Protects /api/cron/*. Generate: openssl rand -base64 32
CRON_SECRET=

# --- Mock mode only (ignored in live) ---------------------------------
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=

# --- Live mode --------------------------------------------------------
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Texts: provider not chosen yet (see TODO-LIVE.md)
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM_NUMBER=
