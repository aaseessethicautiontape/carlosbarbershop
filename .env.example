# Copy to .env.local and fill in by hand. Never commit .env.local.
# Values come from the Neon console (or the Neon MCP/CLI): Connect, Auth, Realtime pages.

# --- Mode -------------------------------------------------------------
# mock = demo data + outbox log + demo login buttons. live = real emails, real staff accounts only.
NEXT_PUBLIC_APP_MODE=
NEXT_PUBLIC_SITE_URL=

# --- Neon (database, auth, realtime) ----------------------------------
# SERVER ONLY. Owner connection string (pooled). Bypasses RLS: never prefix with NEXT_PUBLIC_.
DATABASE_URL=
# Managed Better Auth URL (Neon console > Auth). Cookie secret: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Realtime (Neon console > Realtime). The secret is SERVER ONLY (it can seal any query).
NEON_REALTIME_URL=
NEXT_PUBLIC_NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
NEON_REALTIME_DB=neondb

# --- App secrets ------------------------------------------------------
# 32+ random chars. Signs booking/walk-in links. Generate: openssl rand -base64 48
APP_TOKEN_SECRET=
# Protects /api/cron/*. Generate: openssl rand -base64 32
CRON_SECRET=

# --- Mock mode only (ignored in live) ---------------------------------
DEMO_OWNER_EMAIL=
DEMO_BARBER_EMAIL=
DEMO_PASSWORD=

# --- Live mode --------------------------------------------------------
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Texts: provider not chosen yet (see TODO-LIVE.md)
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM_NUMBER=
