{
  "name": "carlos-barbershop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3470",
    "build": "next build",
    "start": "next start -p 3470",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:secrets": "tsx scripts/check-no-service-role-in-client.ts",
    "db:migrate": "node scripts/db-apply.mjs",
    "db:seed": "node scripts/db-apply.mjs --seed",
    "db:check": "tsx --env-file=.env.local scripts/db-check.ts",
    "demo:setup": "tsx --env-file=.env.local scripts/setup-demo-users.ts",
    "demo": "next build && next start -p 3470",
    "db:reset-demo": "node --env-file=.env.local scripts/db-reset-demo.mjs"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@neon/auth": "^0.8.2",
    "@neon/realtime": "^0.2.1",
    "@neondatabase/serverless": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "next": "15.5.29",
    "papaparse": "^5.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.38.0",
    "server-only": "^0.0.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
